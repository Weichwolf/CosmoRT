# CosmoRT Kernel Config (synthetisch, fuer LTP tst_kconfig_check).
# Werte: =y (feature da), =n (nicht da), nicht aufgefuehrt = unknown.
# LTP parsed das via tst_kconfig_read wie einen Linux .config.

CONFIG_AF_UNIX=y
CONFIG_AF_UNIX_OOB=y
CONFIG_UNIX=y
CONFIG_UNIX_DIAG=n

CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NET=y
CONFIG_NETFILTER=n

CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y

CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_RAM=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=n
CONFIG_PROC_FS=y
CONFIG_SYSFS=n

CONFIG_MMU=y
CONFIG_SWAP=n
CONFIG_MEMCG=n

CONFIG_PREEMPT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_HIGH_RES_TIMERS=y

CONFIG_CHECKPOINT_RESTORE=n
CONFIG_CGROUPS=n
CONFIG_NAMESPACES=n
CONFIG_USER_NS=n
CONFIG_PID_NS=n
CONFIG_NET_NS=n
CONFIG_IPC_NS=n
CONFIG_UTS_NS=n
CONFIG_MOUNT_NS=n

CONFIG_SECCOMP=n
CONFIG_AUDIT=n
CONFIG_KEYS=n
CONFIG_SECURITY=n
CONFIG_BPF=n
CONFIG_BPF_SYSCALL=n

CONFIG_AIO=n

CONFIG_MODULES=n

CONFIG_SYSVIPC=n
CONFIG_POSIX_MQUEUE=n

CONFIG_UID16=n
CONFIG_32BIT=n
CONFIG_X86_64=y
